PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
ANTHROPIC_API_KEY=your_anthropic_api_key

# Email verification (Resend) — without this, verification codes are only
# logged to the server console, which is fine for local dev.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=RelaySupport <onboarding@resend.dev>

# Google Sign-In — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
